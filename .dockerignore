# ===== Docker 构建上下文排除（镜像瘦身 + 安全红线） =====
.git
.gitignore

# 依赖与虚拟环境（镜像内重新安装）
**/node_modules
**/.venv
venv/
env/

# Python 缓存
**/__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# 密钥与环境变量（绝不进镜像；DEEPSEEK_API_KEY 由平台注入）
.env
.env.*
!.env.example

# 用户数据（SQLite / ChromaDB，挂载卷而非打包进镜像）
backend/data/
chroma/

# 前端构建产物（阶段 1 内重新构建）
frontend/dist/
frontend/.vite/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# 生成物 / 日志
outputs/
backend/test_*.pdf
*.log
.DS_Store
Thumbs.db
