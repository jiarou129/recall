# ============================================================
# Recall AI · 仓库根 .gitignore（前后端 monorepo）
# ============================================================

# ===== 前端依赖与构建产物 =====
node_modules/
dist/
build/
.vite/
*.local

# ===== 后端虚拟环境 =====
.venv/
venv/
env/

# ===== Python 缓存 =====
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/

# ===== 密钥 / 环境变量（绝不提交） =====
.env
.env.*
!.env.example

# ===== 用户数据（本地优先，不入库） =====
backend/data/
chroma/

# ===== 生成物 / 测试残留 =====
outputs/
backend/test_*.pdf
*.log

# ===== TypeScript / Vite 构建产物（vue-tsc -b 生成，非源码） =====
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# ===== 系统与编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
